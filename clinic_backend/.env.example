# =================================================================
# ClinicOS Backend Environment Configuration (PostgreSQL)
# =================================================================

# 1. Database Connection (Option A: Single Cloud Connection String - Recommended for Neon/Supabase/Render)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Database Connection (Option B: Individual Connection Parameters - Local or Custom)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_NAME=clinicos

# 3. Application Server Settings
PORT=5001
JWT_SECRET=your_super_secret_jwt_key_that_is_very_long_and_secure_12345

# 4. Default Initial Administrator Account (Auto-created on boot)
ADMIN_NAME=Hospital Authority
ADMIN_EMAIL=admin@clinic.com
ADMIN_PASSWORD=Admin@12345
